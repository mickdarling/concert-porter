{
  // Deploy: wrangler deploy
  // Then:   wrangler secret put SETLISTFM_API_KEY   (optional — callers can bring their own key)
  "name": "concert-porter-relay",
  "main": "setlistfm-relay.js",
  "compatibility_date": "2026-07-01",
  "observability": { "enabled": true },
  "unsafe": {
    "bindings": [
      // per-IP: one polite client (the site throttles itself to ~1.4/s) never trips this
      { "name": "RL_IP", "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } },
      // global ceiling ≈ setlist.fm's own ~2 req/s free-tier cap, so the key can't be exhausted
      { "name": "RL_GLOBAL", "type": "ratelimit", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
    ]
  }
}
